#!/usr/bin/env bash
# ==============================================================================
# TUI Package & Web App Manager (Install & Uninstall)
# Target: CachyOS / Arch Linux (Wayland / Niri)
# ==============================================================================

set -euo pipefail

# ------------------------------------------------------------------------------
# Colors & Styling
# ------------------------------------------------------------------------------
BORDER_COLOR="#7aa2f7"
HEADER_COLOR="#bb9af7"
DANGER_COLOR="#f7768e"
SUCCESS_COLOR="#9ece6a"

# Navigation Binds:
# - Menus: W/S, K/J, and Arrows navigate directly
# - Search Lists: Ctrl+W / Ctrl+S navigate; W/S type into the search query
MENU_NAV_BINDS="w:up,s:down"
SEARCH_NAV_BINDS="ctrl-w:up,ctrl-s:down"

banner() {
  clear
  gum style \
    --foreground "$BORDER_COLOR" \
    --border-foreground "$BORDER_COLOR" \
    --border double \
    --align center \
    --width 54 \
    --margin "1 0" \
    --padding "0 1" \
    "󰣇  PACKAGE & APP MANAGER" "Install • Uninstall • Web Apps"
}

# ------------------------------------------------------------------------------
# 1. Official Arch Linux Repositories (Install)
# ------------------------------------------------------------------------------
install_arch_pkg() {
  clear
  gum style --foreground "$HEADER_COLOR" --bold "Fetching official repository index..."
  
  local selected_pkgs
  selected_pkgs=$(pacman -Slq | fzf \
    --multi \
    --prompt="󰣇 Arch Repo > " \
    --header="[Type]: Search | [Ctrl+W/S]: Move | [TAB]: Select | [ENTER]: Install" \
    --bind="$SEARCH_NAV_BINDS" \
    --color="border:$BORDER_COLOR,header:$HEADER_COLOR,prompt:#7dcfff,pointer:#f7768e" \
    --preview="pacman -Si {} 2>/dev/null" \
    --preview-window="right:55%:wrap" \
    --border="rounded")

  if [[ -n "$selected_pkgs" ]]; then
    clear
    gum style --foreground "$BORDER_COLOR" "Selected packages to install:"
    echo "$selected_pkgs" | sed 's/^/  • /'
    echo ""
    if gum confirm "Proceed with installation via pacman?"; then
      # shellcheck disable=SC2086
      sudo pacman -S --needed $selected_pkgs
      gum style --foreground "$SUCCESS_COLOR" "✔ Installation finished."
      read -n 1 -s -r -p "Press any key to continue..."
    fi
  fi
}

# ------------------------------------------------------------------------------
# 2. AUR Packages (Install)
# ------------------------------------------------------------------------------
install_aur_pkg() {
  clear
  local aur_helper="paru"
  if ! command -v paru &>/dev/null; then
    aur_helper="yay"
  fi

  gum style --foreground "$HEADER_COLOR" --bold "Fetching full AUR package index..."

  local selected_pkgs
  selected_pkgs=$($aur_helper -Slqa | awk '!seen[$1]++' | fzf \
    --multi \
    --prompt="󰣚 AUR > " \
    --header="[Type]: Search | [Ctrl+W/S]: Move | [TAB]: Select | [ENTER]: Install" \
    --bind="$SEARCH_NAV_BINDS" \
    --color="border:$BORDER_COLOR,header:$HEADER_COLOR,prompt:#7dcfff,pointer:#f7768e" \
    --preview="$aur_helper -Si {} 2>/dev/null" \
    --preview-window="right:55%:wrap" \
    --border="rounded")

  if [[ -n "$selected_pkgs" ]]; then
    clear
    gum style --foreground "$BORDER_COLOR" "Selected package(s) to install:"
    echo "$selected_pkgs" | sed 's/^/  • /'
    echo ""
    if gum confirm "Proceed with installation via $aur_helper?"; then
      # shellcheck disable=SC2086
      $aur_helper -S --needed $selected_pkgs
      gum style --foreground "$SUCCESS_COLOR" "✔ Installation finished."
      read -n 1 -s -r -p "Press any key to continue..."
    fi
  fi
}

# ------------------------------------------------------------------------------
# 3. Web App Creation (Install)
# ------------------------------------------------------------------------------
install_web_app() {
  clear
  gum style --foreground "$HEADER_COLOR" --bold "Create Standalone Web App Launcher"
  echo ""

  local app_name
  app_name=$(gum input --prompt "App Name > " --placeholder "e.g., ChatGPT, Notion, Discord")
  [[ -z "$app_name" ]] && return

  local app_url
  app_url=$(gum input --prompt "Web URL  > " --placeholder "https://chatgpt.com")
  [[ -z "$app_url" ]] && return

  if [[ ! "$app_url" =~ ^https?:// ]]; then
    app_url="https://$app_url"
  fi

  local domain
  domain=$(echo "$app_url" | awk -F/ '{print $3}')
  local slug
  slug=$(echo "$app_name" | tr '[:upper:]' '[:lower:]' | tr -s ' ' '-' | tr -cd '[:alnum:]-')

  local available_browsers=()
  for b in ungoogled-chromium chromium brave google-chrome-stable firefox; do
    if command -v "$b" &>/dev/null; then
      available_browsers+=("$b")
    fi
  done

  if [ ${#available_browsers[@]} -eq 0 ]; then
    gum style --foreground "$DANGER_COLOR" "✖ No supported Chromium/Firefox browser found in PATH."
    read -n 1 -s -r -p "Press any key to return..."
    return
  fi

  local browser
  browser=$(printf "%s\n" "${available_browsers[@]}" | fzf \
    --prompt="Select Browser > " \
    --header="[W/S or ↑/↓]: Move | [ENTER]: Select" \
    --bind="$MENU_NAV_BINDS" \
    --color="border:$BORDER_COLOR,header:$HEADER_COLOR" \
    --height="30%" \
    --border="rounded")
  [[ -z "$browser" ]] && return

  local icon_dir="$HOME/.local/share/icons/hicolor/128x128/apps"
  local desktop_dir="$HOME/.local/share/applications"
  mkdir -p "$icon_dir" "$desktop_dir"

  local icon_path="$icon_dir/web-$slug.png"
  local fallback_icon="applications-internet"

  gum style --foreground "$BORDER_COLOR" "Fetching icon for $domain..."
  curl -sSL --max-time 5 "https://www.google.com/s2/favicons?domain=${domain}&sz=128" -o "$icon_path" || true

  if [[ ! -s "$icon_path" ]] || ! file --mime-type "$icon_path" | grep -q "image/"; then
    rm -f "$icon_path"
    icon_path="$fallback_icon"
  fi

  cat <<EOF > "$desktop_dir/web-$slug.desktop"
[Desktop Entry]
Version=1.0
Type=Application
Name=$app_name
Comment=Web Application for $app_name
Exec=$HOME/.local/bin/launch-webapp "$app_url" "$slug" "$browser"
Icon=$icon_path
Terminal=false
Categories=Network;WebApplication;
EOF

  chmod +x "$desktop_dir/web-$slug.desktop"
  update-desktop-database "$desktop_dir" &>/dev/null || true

  clear
  gum style \
    --foreground "$SUCCESS_COLOR" \
    --border normal \
    --border-foreground "$SUCCESS_COLOR" \
    --padding "1 2" \
    "✔ Web App '$app_name' created successfully!" \
    "Launcher: $desktop_dir/web-$slug.desktop" \
    "Browser:  $browser"
  
  read -n 1 -s -r -p "Press any key to continue..."
}

# ------------------------------------------------------------------------------
# 4. Uninstall: Arch Native Packages
# ------------------------------------------------------------------------------
uninstall_arch_pkg() {
  clear
  gum style --foreground "$HEADER_COLOR" --bold "Scanning explicitly installed Native packages..."

  local selected_pkgs
  selected_pkgs=$(pacman -Qne | awk '{print $1}' | fzf \
    --multi \
    --prompt="󰆴 Remove Arch Native > " \
    --header="[Type]: Search | [Ctrl+W/S]: Move | [TAB]: Select | [ENTER]: Remove" \
    --bind="$SEARCH_NAV_BINDS" \
    --color="border:$DANGER_COLOR,header:$HEADER_COLOR,prompt:$DANGER_COLOR,pointer:$DANGER_COLOR" \
    --preview="pacman -Qi {} 2>/dev/null" \
    --preview-window="right:55%:wrap" \
    --border="rounded")

  if [[ -n "$selected_pkgs" ]]; then
    clear
    gum style --foreground "$DANGER_COLOR" --bold "Selected packages to remove (and unneeded dependencies):"
    echo "$selected_pkgs" | sed 's/^/  • /'
    echo ""
    if gum confirm "Are you sure you want to run 'pacman -Rns'?"; then
      # shellcheck disable=SC2086
      sudo pacman -Rns $selected_pkgs
      gum style --foreground "$SUCCESS_COLOR" "✔ Native package(s) removed successfully."
      read -n 1 -s -r -p "Press any key to continue..."
    fi
  fi
}

# ------------------------------------------------------------------------------
# 5. Uninstall: AUR Packages
# ------------------------------------------------------------------------------
uninstall_aur_pkg() {
  clear
  local aur_helper="paru"
  if ! command -v paru &>/dev/null; then
    aur_helper="yay"
  fi

  gum style --foreground "$HEADER_COLOR" --bold "Scanning explicitly installed AUR packages..."

  local selected_pkgs
  selected_pkgs=$(pacman -Qme | awk '{print $1}' | fzf \
    --multi \
    --prompt="󰆴 Remove AUR > " \
    --header="[Type]: Search | [Ctrl+W/S]: Move | [TAB]: Select | [ENTER]: Remove" \
    --bind="$SEARCH_NAV_BINDS" \
    --color="border:$DANGER_COLOR,header:$HEADER_COLOR,prompt:$DANGER_COLOR,pointer:$DANGER_COLOR" \
    --preview="$aur_helper -Qi {} 2>/dev/null || pacman -Qi {} 2>/dev/null" \
    --preview-window="right:55%:wrap" \
    --border="rounded")

  if [[ -n "$selected_pkgs" ]]; then
    clear
    gum style --foreground "$DANGER_COLOR" --bold "Selected AUR packages to remove:"
    echo "$selected_pkgs" | sed 's/^/  • /'
    echo ""
    if gum confirm "Are you sure you want to run '$aur_helper -Rns'?"; then
      # shellcheck disable=SC2086
      $aur_helper -Rns $selected_pkgs
      gum style --foreground "$SUCCESS_COLOR" "✔ AUR package(s) removed successfully."
      read -n 1 -s -r -p "Press any key to continue..."
    fi
  fi
}

# ------------------------------------------------------------------------------
# 6. Uninstall: Web Applications
# ------------------------------------------------------------------------------
uninstall_web_app() {
  clear
  local desktop_dir="$HOME/.local/share/applications"
  local icon_dir="$HOME/.local/share/icons/hicolor/128x128/apps"
  local profile_base="$HOME/.local/share/web-apps"

  local web_apps=()
  while IFS= read -r file; do
    [[ -f "$file" ]] && web_apps+=("$(basename "$file" .desktop)")
  done < <(find "$desktop_dir" -maxdepth 1 -name "web-*.desktop" 2>/dev/null)

  if [ ${#web_apps[@]} -eq 0 ]; then
    gum style --foreground "$DANGER_COLOR" "No installed web apps found."
    read -n 1 -s -r -p "Press any key to return..."
    return
  fi

  local preview_cmd='
    app="{}"
    slug="${app#web-}"
    desktop_file="'"$desktop_dir"'/$app.desktop"
    prof="'"$profile_base"'/$slug"
    
    echo "=== Desktop File ==="
    cat "$desktop_file" 2>/dev/null
    echo ""
    echo "=== Storage Profile ==="
    if [ -d "$prof" ]; then
      du -sh "$prof" 2>/dev/null
    else
      echo "No profile data stored."
    fi
  '

  local selected_apps
  selected_apps=$(printf "%s\n" "${web_apps[@]}" | fzf \
    --multi \
    --prompt="󰆴 Remove Web App > " \
    --header="[Type]: Search | [Ctrl+W/S]: Move | [TAB]: Select | [ENTER]: Remove" \
    --bind="$SEARCH_NAV_BINDS" \
    --color="border:$DANGER_COLOR,header:$HEADER_COLOR,prompt:$DANGER_COLOR,pointer:$DANGER_COLOR" \
    --preview="$preview_cmd" \
    --preview-window="right:55%:wrap" \
    --border="rounded")

  if [[ -n "$selected_apps" ]]; then
    clear
    gum style --foreground "$DANGER_COLOR" --bold "Selected Web Apps to remove:"
    echo "$selected_apps" | sed 's/^/  • /'
    echo ""
    if gum confirm "Delete desktop shortcuts, icons, and local data profiles?"; then
      while IFS= read -r app_entry; do
        [[ -z "$app_entry" ]] && continue
        local slug="${app_entry#web-}"
        rm -f "$desktop_dir/$app_entry.desktop"
        rm -f "$icon_dir/$app_entry.png"
        rm -rf "$profile_base/$slug"
      done <<< "$selected_apps"

      update-desktop-database "$desktop_dir" &>/dev/null || true
      gum style --foreground "$SUCCESS_COLOR" "✔ Web App(s) and isolated profiles deleted."
      read -n 1 -s -r -p "Press any key to continue..."
    fi
  fi
}

# ------------------------------------------------------------------------------
# Uninstallation Submenu
# ------------------------------------------------------------------------------
uninstall_menu() {
  while true; do
    clear
    banner
    local choice
    choice=$(printf "%s\n" \
      "󰣇  Remove Arch Native Package (pacman -Rns)" \
      "󰣚  Remove AUR Package (paru / yay -Rns)" \
      "󰖟  Remove Web Application & Profiles" \
      "󰌍  Back to Main Menu" | fzf \
      --prompt="Uninstall Mode > " \
      --header="[W/S or ↑/↓]: Move | [ENTER]: Select" \
      --bind="$MENU_NAV_BINDS" \
      --color="border:$DANGER_COLOR,header:$HEADER_COLOR,prompt:$DANGER_COLOR,pointer:$DANGER_COLOR" \
      --height="40%" \
      --border="rounded")

    case "$choice" in
      *"Arch Native"*)
        uninstall_arch_pkg
        ;;
      *"AUR Package"*)
        uninstall_aur_pkg
        ;;
      *"Web Application"*)
        uninstall_web_app
        ;;
      *"Back"*)
        break
        ;;
      *)
        break
        ;;
    esac
  done
}

# ------------------------------------------------------------------------------
# Main Menu Loop
# ------------------------------------------------------------------------------
main() {
  while true; do
    banner
    local choice
    choice=$(printf "%s\n" \
      "󰣇  Install Arch Native Package" \
      "󰣚  Install AUR Package" \
      "󰖟  Install Web Application" \
      "󰆴  Uninstall / Remove Packages & Apps" \
      "󰈆  Quit" | fzf \
      --prompt="Main Menu > " \
      --header="[W/S or ↑/↓]: Move | [ENTER]: Select" \
      --bind="$MENU_NAV_BINDS" \
      --color="border:$BORDER_COLOR,header:$HEADER_COLOR,prompt:#7dcfff,pointer:#f7768e" \
      --height="45%" \
      --border="rounded")

    case "$choice" in
      *"Install Arch Native"*)
        install_arch_pkg
        ;;
      *"Install AUR"*)
        install_aur_pkg
        ;;
      *"Install Web Application"*)
        install_web_app
        ;;
      *"Uninstall"*)
        uninstall_menu
        ;;
      *"Quit"*)
        clear
        exit 0
        ;;
      *)
        clear
        exit 0
        ;;
    esac
  done
}

main