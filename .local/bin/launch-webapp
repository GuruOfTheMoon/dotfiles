#!/usr/bin/env bash
# ==============================================================================
# Web App Runner
# Handles Wayland/Niri isolation and browser-specific quirks
# ==============================================================================

set -euo pipefail

APP_URL="${1:-}"
APP_SLUG="${2:-}"
BROWSER="${3:-ungoogled-chromium}"

if [[ -z "$APP_URL" || -z "$APP_SLUG" ]]; then
  echo "Usage: launch-webapp <URL> <APP_SLUG> [BROWSER]"
  exit 1
fi

# Fall back if selected browser is missing
if ! command -v "$BROWSER" &>/dev/null; then
  for fallback in ungoogled-chromium chromium brave google-chrome-stable firefox; do
    if command -v "$fallback" &>/dev/null; then
      BROWSER="$fallback"
      break
    fi
  done
fi

PROFILE_DIR="$HOME/.local/share/web-apps/$APP_SLUG"
mkdir -p "$PROFILE_DIR"

if ! command -v "$BROWSER" &>/dev/null; then
  echo "No supported browser found. Install chromium, brave, google-chrome-stable, or firefox." >&2
  exit 1
fi

if [[ "$BROWSER" == "firefox" ]]; then
  exec firefox --new-window "$APP_URL"
else
  # Chromium / Ungoogled Chromium / Brave native Wayland execution
  exec "$BROWSER" \
    --ozone-platform-hint=auto \
    --enable-features=WaylandWindowDecorations \
    --app="$APP_URL" \
    --user-data-dir="$PROFILE_DIR" \
    --no-first-run \
    --no-default-browser-check \
    --wm-window-role="web-$APP_SLUG"
fi
